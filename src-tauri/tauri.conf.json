{
  "version": "0.1.0-test.1",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": false,
    "longDescription": "Clash Verge Clew: per-application IPv4 TCP proxy routing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/",
      "../LICENSE": "resources/licenses/Clash-Verge-Rev-GPL-3.0.txt",
      "../vendor/clew/LICENSE": "resources/licenses/Clew-MIT.txt",
      "../vendor/clew/THIRD_PARTY_NOTICES.md": "resources/licenses/Clew-THIRD_PARTY_NOTICES.md",
      "../vendor/clew/WinDivert-2.2.2-A/LICENSE": "resources/licenses/WinDivert-LICENSE.txt",
      "../vendor/clew/build/Release/clew.exe": "resources/clew.exe",
      "../vendor/clew/build/Release/WinDivert.dll": "resources/WinDivert.dll",
      "../vendor/clew/build/Release/WinDivert64.sys": "resources/WinDivert64.sys",
      "../vendor/clew/build/Release/brotlienc.dll": "resources/brotlienc.dll",
      "../vendor/clew/build/Release/brotlidec.dll": "resources/brotlidec.dll",
      "../vendor/clew/build/Release/brotlicommon.dll": "resources/brotlicommon.dll",
      "../vendor/clew/build/Release/msvcp140.dll": "resources/msvcp140.dll",
      "../vendor/clew/build/Release/msvcp140_1.dll": "resources/msvcp140_1.dll",
      "../vendor/clew/build/Release/msvcp140_2.dll": "resources/msvcp140_2.dll",
      "../vendor/clew/build/Release/msvcp140_atomic_wait.dll": "resources/msvcp140_atomic_wait.dll",
      "../vendor/clew/build/Release/vcruntime140.dll": "resources/vcruntime140.dll",
      "../vendor/clew/build/Release/vcruntime140_1.dll": "resources/vcruntime140_1.dll"
    },
    "publisher": "Clash Verge Clew Project",
    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "Per-application IPv4 TCP proxy routing",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "Clash Verge Clew",
  "identifier": "app.clashvergeclew.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": []
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
